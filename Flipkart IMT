                <div><div class="info-title">Transport Resource for...</div><div class="info-sub">Mobile cart used for picking & movement</div></div>
            </div>
        </div>
    </div>

    <!-- 5S TAB -->
    <div id="tab-5s" style="display: none;">
        <div class="grid-container">
            <div class="info-card" style="border-left: 4px solid #ef4444;">
                <div class="info-badge" style="background:#ef4444; color:#fff;">5S (1)</div>
