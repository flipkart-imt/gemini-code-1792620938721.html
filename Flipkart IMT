    <script>
        document.addEventListener("DOMContentLoaded", () => {
            renderTable();
            const savedCasper = localStorage.getItem("last_casper_id");
            if (savedCasper) document.getElementById("scan-casper").value = savedCasper;
            onProcessChange();
        });

        function onProcessChange() {
            const proc = document.getElementById("selected-process").value;
            const irtBox = document.getElementById("irt-fields");
            const w2wBox = document.getElementById("w2w-fields");
            const rcaBox = document.getElementById("rca-fields");

            irtBox.style.display = (proc === "IRT") ? "grid" : "none";
            w2wBox.style.display = (proc === "W2W") ? "grid" : "none";
            rcaBox.style.display = (proc === "RCA") ? "grid" : "none";
        }

        function calcVariance() {
            const phy = parseFloat(document.getElementById("scan-phy-qty").value) || 0;
            const sys = parseFloat(document.getElementById("scan-sys-qty").value) || 0;
            const diff = phy - sys;

            const vElem = document.getElementById("variance-val");
            vElem.innerText = (diff > 0 ? "+" : "") + diff;
            vElem.style.color = (diff === 0) ? "#10b981" : "#ef4444";

            const statusSelect = document.getElementById("scan-status");
            if (diff === 0) {
                statusSelect.value = "Variance Done";
            } else {
                statusSelect.value = "Variance Pending";
            }
        }

        function saveScanData() {
            const proc = document.getElementById("selected-process").value;
            const casper = document.getElementById("scan-casper").value.trim();
            const bin = document.getElementById("scan-bin").value.trim();
            const wid = document.getElementById("scan-wid").value.trim();
            const phyQty = document.getElementById("scan-phy-qty").value.trim() || "0";

            if (!casper || !bin || !wid) {
                alert("Please fill Casper / IRT ID, Bin Location, and WID Barcode!");
                return;
            }

            localStorage.setItem("last_casper_id", casper);

            let sysQty = "N/A";
            let variance = "N/A";
            let status = "Completed";
            let remarks = document.getElementById("scan-remarks").value.trim() || "N/A";

            if (proc === "IRT") {
                const altBin = document.getElementById("irt-alt-bin").value.trim() || "Short";
                status = `IRT: ${document.getElementById("irt-action-status").value}`;
                sysQty = `Alt Bin: ${altBin}`;
            } else if (proc === "W2W") {
                sysQty = document.getElementById("scan-sys-qty").value.trim() || "0";
                variance = (parseFloat(phyQty) || 0) - (parseFloat(sysQty) || 0);
                status = document.getElementById("scan-status").value;
            } else if (proc === "RCA") {
                const res = document.getElementById("rca-resolution").value;
                const shortBin = document.getElementById("rca-short-bin").value.trim() || "N/A";
                status = `RCA: ${res}`;
                if (shortBin !== "N/A") remarks = `Short Bin: ${shortBin} | ${remarks}`;
            }

            const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const record = { 
                time: timestamp, 
                proc: proc, 
                casper: casper, 
                bin: bin, 
                wid: wid, 
                phyQty: phyQty, 
                sysQty: sysQty, 
                variance: variance, 
                status: status, 
                remarks: remarks 
            };

            let records = JSON.parse(localStorage.getItem("all_scan_data")) || [];
            records.unshift(record);
            localStorage.setItem("all_scan_data", JSON.stringify(records));

            // Clear inputs for next rapid scan
            document.getElementById("scan-bin").value = "";
            document.getElementById("scan-wid").value = "";
            document.getElementById("scan-phy-qty").value = "";
            document.getElementById("scan-sys-qty").value = "";
            document.getElementById("irt-alt-bin").value = "";
            document.getElementById("rca-short-bin").value = "";
            document.getElementById("scan-remarks").value = "";
            document.getElementById("variance-val").innerText = "0";
            document.getElementById("variance-val").style.color = "var(--fk-yellow)";
            document.getElementById("scan-bin").focus();

            renderTable();
        }

        function renderTable() {
            const records = JSON.parse(localStorage.getItem("all_scan_data")) || [];
            const tbody = document.getElementById("scan-table-body");
            document.getElementById("total-count").innerText = records.length;

            if (records.length === 0) {
                tbody.innerHTML = `<tr><td colspan="10" style="text-align:center; color: var(--text-muted);">No scans recorded today yet.</td></tr>`;
                return;
            }

            tbody.innerHTML = records.map(r => {
                let statusClass = "status-done";
                if (r.status === "Variance Pending") statusClass = "status-pending";
                if (r.status === "In Transit") statusClass = "status-transit";
                if (r.status.includes("RCA")) statusClass = "status-rca";
                if (r.status.includes("IRT")) statusClass = "status-irt";

                let varDisplay = r.variance;
                if (r.variance !== "N/A") {
                    const numVar = parseFloat(r.variance);
                    varDisplay = `<b style="color:${numVar === 0 ? 'var(--accent-green)' : 'var(--accent-red)'}">${numVar > 0 ? '+' : ''}${numVar}</b>`;
                }

                return `
                    <tr>
                        <td>${r.time}</td>
                        <td><b style="color:var(--fk-yellow);">${r.proc}</b></td>
                        <td><b>${r.casper || 'N/A'}</b></td>
                        <td>${r.bin || 'N/A'}</td>
                        <td>${r.wid || 'N/A'}</td>
                        <td><b>${r.phyQty || '0'}</b></td>
                        <td>${r.sysQty || 'N/A'}</td>
                        <td>${varDisplay}</td>
                        <td><span class="status-badge ${statusClass}">${r.status}</span></td>
                        <td>${r.remarks || 'N/A'}</td>
                    </tr>
                `;
            }).join("");
        }

        function clearData() {
            if (confirm("Are you sure you want to clear all scanned records for today?")) {
                localStorage.removeItem("all_scan_data");
                renderTable();
            }
        }

        function exportDataCSV() {
            const records = JSON.parse(localStorage.getItem("all_scan_data")) || [];
            if (records.length === 0) {
                alert("No scan data available to export.");
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,Time,Process,Casper ID,Bin Location,WID,Physical Qty,System Qty / Alt Bin,Variance,Status/Action,Remarks\n";
            records.forEach(r => {
                csvContent += `${r.time},${r.proc},${r.casper},${r.bin},${r.wid},${r.phyQty},"${r.sysQty}",${r.variance},"${r.status}","${r.remarks}"\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Flipkart_Audit_Data_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        function switchTab(tabName) {
            document.getElementById("tab-process").style.display = tabName === 'process' ? 'block' : 'none';
            document.getElementById("tab-fullforms").style.display = tabName === 'fullforms' ? 'block' : 'none';
            document.getElementById("tab-5s").style.display = tabName === '5s' ? 'block' : 'none';

            const tabs = document.querySelectorAll('.tab-btn');
            tabs[0].classList.toggle('active', tabName === 'process');
            tabs[1].classList.toggle('active', tabName === 'fullforms');
            tabs[2].classList.toggle('active', tabName === '5s');
        }
    </script>
</body>
</html>
